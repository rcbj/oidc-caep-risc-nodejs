{
  "name": "oidc-caep-risc-nodejs",
  "version": "0.1.0",
  "description": "Server-side OpenID Connect confidential client for Node.js: Authorization Code with PKCE, client authentication, and a CAEP and RISC Shared Signals receiver. TypeScript, usable from JavaScript.",
  "homepage": "https://rcbj.github.io/oidc-caep-risc-nodejs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcbj/oidc-caep-risc-nodejs.git",
    "directory": "packages/oidc-caep-risc-nodejs"
  },
  "bugs": {
    "url": "https://github.com/rcbj/oidc-caep-risc-nodejs/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "oidc-caep-risc-nodejs": "./dist/cli.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "oidc",
    "openid",
    "oauth2",
    "authorization-code",
    "confidential-client",
    "pkce",
    "caep",
    "risc",
    "secevent",
    "shared-signals",
    "ssf"
  ],
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "7.0.2"
  },
  "author": "Iya CyberSecurity Solutions, LLC",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
